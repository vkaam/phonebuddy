[global]
type=global
endpoint_identifier_order=auth_username,ip

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0

[phonebuddy-test-auth]
type=auth
auth_type=userpass
username=phonebuddy-test
password=__WEBRTC_TEST_PASSWORD__

[phonebuddy-test]
type=endpoint
transport=transport-wss
context=controlled-test
disallow=all
allow=opus,ulaw,alaw
auth=phonebuddy-test-auth
aors=phonebuddy-test
webrtc=yes
media_encryption=dtls
ice_support=yes
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtls_cert_file=/run/phonebuddy/certificates/fullchain.pem
dtls_private_key=/run/phonebuddy/certificates/privkey.pem
dtls_setup=actpass

[phonebuddy-test]
type=aor
max_contacts=1
remove_existing=yes
remove_unavailable=yes
